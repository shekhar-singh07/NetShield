# ==============================================================================
# NetShield-ML Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env (Linux/macOS)
#   copy .env.example .env (Windows cmd)
#   Copy-Item .env.example .env (Windows PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# LAPTOP B (SERVER / NIDS ENGINE) CONFIGURATION
# ------------------------------------------------------------------------------

# Host and port for the NetShield TCP Server (receives agent heartbeats on Laptop B)
# Use 0.0.0.0 to listen on all network interfaces across the LAN.
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Host and port for the FastAPI Backend REST server
# Use 0.0.0.0 so the React frontend on any LAN device can reach the API.
API_HOST=0.0.0.0
API_PORT=8000

# Network interface for packet capture via TShark
# Run `tshark -D` on Laptop B to list available interfaces.
# Examples:
#   Windows: "Wi-Fi" or "Ethernet" or interface index like "1"
#   Linux: "eth0" or "wlan0" or "enp3s0"
# Leave blank to run in synthetic injection & testbed mode if TShark is not installed.
CAPTURE_INTERFACE=

# SQLite Database storage path
DATABASE_PATH=netshield.db

# Intrusion detection heuristic thresholds
DETECTION_PKT_RATE=500
DETECTION_PORT_SCAN=15
DETECTION_CONN_BURST=50

# ------------------------------------------------------------------------------
# LAPTOP A (AGENT / ATTACK SIMULATOR) CONFIGURATION
# ------------------------------------------------------------------------------

# IP address of Laptop B on the local Wi-Fi / LAN network.
# Find Laptop B's LAN IP using `ipconfig` (Windows) or `ip a` (Linux).
# Example: 192.168.1.50
REMOTE_HOST=127.0.0.1
REMOTE_PORT=5000

# API port of Laptop B if triggering simulation endpoints remotely
REMOTE_API_PORT=8000

# ------------------------------------------------------------------------------
# FRONTEND DASHBOARD (VITE / REACT)
# ------------------------------------------------------------------------------

# Base URL of the FastAPI backend.
# - If running frontend on Laptop B: http://localhost:8000
# - If accessing dashboard from Laptop A or another LAN device: http://<LAPTOP_B_LAN_IP>:8000
VITE_API_URL=http://localhost:8000

# ----------------------------------------------------------------------
# MACHINE-LEARNING TRAINING DATA
# ----------------------------------------------------------------------

# Point this to a CIC-IDS2017-style CSV file or a directory of CSV files.
# The application never falls back to synthetic training data.
NETSHIELD_DATASET_PATH=datasets/NSL-KDD/KDDTrain%2B.txt
# Optional persisted model location.
# NETSHIELD_MODEL_PATH=backend/detection/nids_random_forest.pkl
